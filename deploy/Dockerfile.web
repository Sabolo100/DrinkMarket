# ─────────────────────────────────────────────────────────────────────────────
# Next.js frontend (standalone output).
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
WORKDIR /app
ENV NODE_ENV=production TZ=Europe/Budapest NEXT_TELEMETRY_DISABLED=1

FROM base AS build
COPY package.json package-lock.json ./
COPY apps/web/ apps/web/
# A base stage NODE_ENV=production-t állít, amitől az npm install kihagyná a
# devDependencies-t. A `next build` viszont a typescriptet és a @types/*
# csomagokat is igényli (a next.config ignoreBuildErrors: false).
RUN npm install --include=dev --workspace @radovin/web --include-workspace-root --ignore-scripts \
 && npm run build --workspace @radovin/web

FROM base AS runtime
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
