# ─────────────────────────────────────────────────────────────────────────────
# Közös image az api / worker / scheduler processzekhez.
# Használat:  docker build --build-arg APP=api -f deploy/Dockerfile.node .
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
RUN apk add --no-cache tini
WORKDIR /app
ENV NODE_ENV=production TZ=Europe/Budapest

# ── Függőségek ───────────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/contracts/package.json      packages/contracts/
COPY packages/observability/package.json  packages/observability/
COPY packages/db/package.json             packages/db/
COPY packages/domain/package.json         packages/domain/
COPY packages/extraction/package.json     packages/extraction/
COPY packages/crawler-core/package.json   packages/crawler-core/
COPY packages/adapters/package.json       packages/adapters/
COPY apps/api/package.json                apps/api/
COPY apps/worker/package.json             apps/worker/
COPY apps/scheduler/package.json          apps/scheduler/
COPY apps/web/package.json                apps/web/
# Csak a három node-processz workspace-e kell. A `--workspaces` a webet is
# telepítené, amivel a Next.js és a React (~470 MB) bekerülne az api, a worker
# és a scheduler image-ébe is, holott egyik sem használja őket.
# Az apps/web/package.json-t viszont másolni kell, hogy a lockfile egyezzen.
RUN npm ci --omit=dev --ignore-scripts --include-workspace-root \
      --workspace @radovin/api \
      --workspace @radovin/worker \
      --workspace @radovin/scheduler \
 || npm install --omit=dev --ignore-scripts

# ── Fordítás ─────────────────────────────────────────────────────────────────
FROM base AS build
COPY package.json package-lock.json tsconfig*.json ./
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/worker/ apps/worker/
COPY apps/scheduler/ apps/scheduler/
# A base stage NODE_ENV=production-t állít, amitől az npm install kihagyná a
# devDependencies-t — köztük a typescriptet. Fordítani viszont abból kell.
# A futtató image továbbra sem kapja meg: a deps stage `--omit=dev`-vel telepít.
RUN npm install --include=dev --ignore-scripts && npm run build

# ── Futtatás ─────────────────────────────────────────────────────────────────
FROM base AS runtime
ARG APP=api
ENV APP=${APP}

COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/${APP}/dist ./apps/${APP}/dist
COPY --from=build /app/apps/${APP}/package.json ./apps/${APP}/package.json
COPY package.json ./

# A migrációkat az API futásidőben olvassa (packages/db/migrations)
RUN mkdir -p /data/evidence && chown -R node:node /data /app
USER node

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "node apps/${APP}/dist/main.js"]
