# ─── Alkalmazás ────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=RADOVIN Price Intelligence
APP_BASE_URL=https://drinkdeal.hu
TZ=Europe/Budapest

# ─── PostgreSQL (Coolify: a Postgres resource "Internal URL" értéke) ───────────
DATABASE_URL=postgres://radovin:changeme@postgres:5432/radovin_pi
DATABASE_SSL=false
DATABASE_POOL_MAX=12
# Induláskor automatikusan lefuttatja a migrációkat (advisory lock alatt)
DB_AUTO_MIGRATE=true

# ─── Redis (Coolify: a Redis resource "Internal URL" értéke) ──────────────────
REDIS_URL=redis://redis:6379

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# 64 hex karakter. Generálás: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
SESSION_TTL_HOURS=12
COOKIE_DOMAIN=
COOKIE_SECURE=true
CORS_ORIGINS=https://drinkdeal.hu

# Első admin felhasználó (csak az első migráció/seed futáskor jön létre)
BOOTSTRAP_ADMIN_EMAIL=admin@drinkdeal.hu
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Szerveroldali (konténerek közti) API cím
API_INTERNAL_URL=http://api:4000
# Böngészőből látható API cím (ha üres: a /api proxyt használja a web)
NEXT_PUBLIC_API_URL=

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_MODE=http            # http | browser | all
WORKER_HTTP_CONCURRENCY=8
WORKER_BROWSER_CONCURRENCY=1
# A felderites futasonkenti idokerete. A crawl policy keresutemevel egyutt ez
# szabja meg, hany termeket er el egy futas: 0,5 keres/mp x 40 perc = 1200.
WORKER_MAX_RUN_MINUTES=40
WORKER_MAX_URLS_PER_RUN=20000
# Hany oran belul szamit "frissnek" egy mar ismert listing. Az ennel
# frissebbeket a felderites atugorja - az atugras nem keres, tehat nem
# fogyasztja a fenti idokeretet. Hosszabbnak kell lennie a felderitesi koznel
# (shops.discovery_interval_hours, alap 168), kulonben nem segit. 0 = kikapcsolva.
DISCOVERY_SKIP_FRESH_HOURS=336
CRAWLER_USER_AGENT=RadovinPriceBot/2.1 (+https://drinkdeal.hu/bot)
CRAWLER_CONTACT_EMAIL=tech@drinkdeal.hu
CRAWLER_DEFAULT_RPS=0.5
CRAWLER_TIMEOUT_MS=20000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_RESPECT_ROBOTS=true

# ─── Objektumtár (nyers bizonyítékok) ────────────────────────────────────────
EVIDENCE_DRIVER=fs          # fs | s3
EVIDENCE_FS_PATH=/data/evidence
EVIDENCE_RETENTION_DAYS=60
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=radovin-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── AI kiegészítés (opcionális, kizárólag evidence-kötött kinyeréshez) ───────
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_CALLS_PER_RUN=200

# ─── Külső kereső API (opcionális, csak jelölt-URL felderítésre) ─────────────
WEBSEARCH_ENABLED=false
WEBSEARCH_PROVIDER=
WEBSEARCH_API_KEY=

# ─── Feature flagek ───────────────────────────────────────────────────────────
FEATURE_AUTO_MATCH=false
FEATURE_AUTO_MATCH_STRICT_IDENTIFIER_ONLY=true
FEATURE_EMBEDDINGS=false
FEATURE_BROWSER_CRAWLER=true

# ─── Utemezo ──────────────────────────────────────────────────────────────────
SCHEDULER_TICK_SECONDS=60
# Hany perc eletjel-szunet utan tekintunk egy crawl futast megszakadtnak.
# A felismeres szivveres-alapu: egy 3 oras katalogusfutas legitim, ha ad
# eletjelet. Enelkul egy deploy altal megolt futas tartosan blokkolna a boltot.
STALE_RUN_MINUTES=15

# ─── Riasztás ─────────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=warn
